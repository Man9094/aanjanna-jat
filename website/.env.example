# Razorpay API Credentials (Get from https://dashboard.razorpay.com/app/keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID can be shared with client for Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"

# HIDDEN SERVER-ONLY SECRETS (NEVER expose to client JS or prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET="your_server_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_hmac_secret_here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
